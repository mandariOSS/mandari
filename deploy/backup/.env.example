# =============================================================================
# mandari Backup-Stack – Beispielkonfiguration (cp .env.example .env)
# =============================================================================

# restic-Repositorys an zwei getrennten Standorten (SFTP genügt, auf dem
# Zielsystem wird kein Programm ausgeführt). Das zweite ist optional,
# für den Produktivbetrieb aber dringend empfohlen.
RESTIC_REPO_1=sftp:benutzer@backup-host-1.example:/mandari
RESTIC_REPO_1_LABEL=standort-1
RESTIC_REPO_2=sftp:benutzer@backup-host-2.example:/mandari
RESTIC_REPO_2_LABEL=standort-2

# Zeitpläne (cron-Syntax, Zeitzone BACKUP_TZ)
BACKUP_CRON="30 2 * * *"
BACKUP_CHECK_CRON="30 6 * * 0"
BACKUP_RESTORE_TEST_CRON="30 4 3 * *"
BACKUP_TZ=Europe/Berlin
# Aufbewahrung: je Tag der letzte Stand, höchstens 30 Tage
BACKUP_KEEP_WITHIN_DAILY=30d
# Name der Sicherungsstände und des Stacks
BACKUP_HOSTNAME=mandari
BACKUP_COMPOSE_PROJECT=mandari-backup

# Datenbank: Superuser des PostgreSQL-Containers im Docker-Netz des mandari-Stacks.
# BACKUP_POSTGRES_IMAGE muss dieselbe Hauptversion wie die Datenbank haben.
BACKUP_DB_NETWORK=mandari_mandari
BACKUP_PG_HOST=mandari-postgres
BACKUP_PG_USER=mandari
BACKUP_PG_PASSWORD=
BACKUP_POSTGRES_IMAGE=postgres:16-alpine
BACKUP_RESTORE_TEST_DB=mandari

# Quellen (Host-Pfade, nur lesend eingehängt)
BACKUP_SRC_CONFIG=../..
BACKUP_SRC_MEDIA=/var/lib/docker/volumes/mandari_media_data/_data
BACKUP_SRC_FILES=/var/lib/docker/volumes/mandari_files_data/_data
BACKUP_SRC_CADDY=/var/lib/docker/volumes/mandari_caddy_data/_data

# Schlüssel, Passwort, Status und Arbeitsverzeichnis (nur für root lesbar anlegen).
# Das restic-Passwort zusätzlich außerhalb des Servers verwahren – ohne es sind
# die Sicherungen nicht lesbar.
BACKUP_SSH_DIR=./ssh
BACKUP_PASSWORD_FILE=./secrets/restic_password
BACKUP_STATUS_DIR=./status
BACKUP_WORK_DIR=./work

# Überwachung (scripts/backup-watchdog.sh auf dem Host)
# Mailversand über den mandari-Container (SMTP aus den Systemeinstellungen)
BACKUP_ALERT_TO=
BACKUP_MAIL_CONTAINER=mandari
BACKUP_MAX_AGE_HOURS=26
