# Vorlage fuer /etc/mandari/staging-update.env (Rechte 600, Besitzer root).
# Gelesen vom Dienst mandari-staging-update.service; alle Variablen im Kopf von
# deploy/scripts/staging_update.sh.

# Pflicht: Installationsverzeichnis der STAGING-Umgebung. Deren .env muss die Zeile
# MANDARI_UMGEBUNG=staging enthalten, sonst bricht das Skript ohne Aenderung ab.
MANDARI_DIR=/srv/mandari-staging

# Pflicht fuer den Dienst: Kopie des Skripts (deploy.sh und verify_deploy.py im selben Verzeichnis)
UPDATE_SKRIPT=/srv/mandari-staging/deploy/staging_update.sh

# Umgebung fuer deploy.sh (Dienstnamen, Compose-Dateien, BACKUP_DIR, NOTIFY_EMAIL, VERIFY_*)
DEPLOY_ENV=/srv/mandari-staging/deploy.env

# Optional
#GITHUB_BRANCH=dev
#STATE_DIR=/srv/mandari-staging/staging-update
#PROTOKOLLE_BEHALTEN=50
# Nur fuer ein hoeheres Abfragelimit der GitHub-API; ein Token ohne jede Berechtigung genuegt
#GITHUB_TOKEN=
