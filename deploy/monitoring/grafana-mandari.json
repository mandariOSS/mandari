{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "mandari – Betrieb",
  "uid": "mandari-betrieb",
  "description": "Anwendungsmetriken von /metrics/ (Issue #231): Latenz p95 je View, Fehlerquote, Pool-Belegung, Cache-Trefferquote; Ereignisse, Aufträge und Worker (Issue #574).",
  "tags": ["mandari"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(mandari_http_requests_total, job)",
        "current": { "text": "mandari", "value": "mandari" },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Antwortzeit p95 je View (5 min)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, view) (rate(mandari_http_request_duration_seconds_bucket{job=\"$job\"}[5m]))))",
          "legendFormat": "{{view}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fehlerquote 5xx (5 min)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mandari_http_requests_total{job=\"$job\",status_class=\"5xx\"}[5m])) / sum(rate(mandari_http_requests_total{job=\"$job\"}[5m]))",
          "legendFormat": "gesamt"
        },
        {
          "refId": "B",
          "expr": "topk(5, sum by (view) (rate(mandari_http_request_errors_total{job=\"$job\"}[5m])))",
          "legendFormat": "5xx/s {{view}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Datenbank-Pool",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "mandari_db_pool_connections{job=\"$job\"}", "legendFormat": "{{state}}" },
        { "refId": "B", "expr": "mandari_db_pool_requests_waiting{job=\"$job\"}", "legendFormat": "wartend" },
        { "refId": "C", "expr": "mandari_db_connections_open{job=\"$job\"}", "legendFormat": "offen (ohne Pool)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache-Trefferquote (Redis, 15 min)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 9, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.8 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mandari_cache_keyspace_hits_total{job=\"$job\"}[15m]) / (rate(mandari_cache_keyspace_hits_total{job=\"$job\"}[15m]) + rate(mandari_cache_keyspace_misses_total{job=\"$job\"}[15m]))",
          "legendFormat": "Trefferquote"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hintergrund (1 h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mandari_emails_total{job=\"$job\",result=\"sent\"}[1h]))", "legendFormat": "Mails gesendet" },
        { "refId": "B", "expr": "sum(increase(mandari_emails_total{job=\"$job\",result=\"failed\"}[1h]))", "legendFormat": "Mails fehlgeschlagen" },
        { "refId": "C", "expr": "sum(increase(mandari_pdf_documents_total{job=\"$job\"}[1h]))", "legendFormat": "PDFs" },
        { "refId": "D", "expr": "sum(mandari_transcription_jobs{job=\"$job\",status=\"queued\"})", "legendFormat": "Transkription wartend" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ereignisse: Rückstand (Alarm ab 5 min)",
      "description": "Sequenzierer und Zustellung je Abonnement (Issue #574); ein pausiertes Abonnement wächst bewusst.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mandari_events_sequencer_lag_seconds)",
          "legendFormat": "Sequenzierer"
        },
        {
          "refId": "B",
          "expr": "max(mandari_events_sequencer_blocked_seconds)",
          "legendFormat": "Sequenzierer aufgehalten"
        },
        {
          "refId": "C",
          "expr": "max by (subscription) (mandari_events_lag_seconds)",
          "legendFormat": "{{subscription}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Aufträge: wartend und älteste Wartezeit",
      "description": "Rückstand des Runners je Warteschlange (Alarm ab 15 min Wartezeit).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (mandari_tasks_queued)",
          "legendFormat": "wartend {{queue}}"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (mandari_tasks_oldest_queued_seconds)",
          "legendFormat": "Wartezeit {{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Gescheitert: Aufträge (24 h) und tote Ereignisse",
      "description": "Jeder Wert über 0 ist ein Alarm; Ursache im Protokoll des Workers, Admin „Aufträge“ bzw. „Ereignisse“.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (queue) (mandari_tasks_dead))",
          "legendFormat": "Aufträge"
        },
        {
          "refId": "B",
          "expr": "sum(max by (subscription) (mandari_events_parked{state=\"tot\"}))",
          "legendFormat": "tote Ereignisse"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Aufträge: Fehlversuche (1 h)",
      "description": "Gescheiterte Versuche je Grund (fehler, endgueltig, zeitgrenze, sperre_abgelaufen); nur aus dem Worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grund) (increase(mandari_tasks_failed_total[1h]))",
          "legendFormat": "{{grund}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Worker: Rollen und Speicher",
      "description": "1 = Rolle arbeitet; Speicher des Runners (Neustart oberhalb von TASKS_MAX_MEMORY_MB).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 419430400
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (role) (mandari_worker_role_up)",
          "legendFormat": "{{role}}"
        },
        {
          "refId": "B",
          "expr": "max(mandari_worker_rss_bytes)",
          "legendFormat": "Speicher Runner"
        }
      ]
    }
  ]
}
