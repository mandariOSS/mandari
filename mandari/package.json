{
  "name": "mandari-frontend",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "build:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "watch": "concurrently \"npm run watch:css\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test:paste": "node frontend/editor/test/paste-cleanup.test.mjs",
    "test:navigation": "node frontend/js/test/navigation.test.mjs"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@alpinejs/focus": "^3.17.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-collaboration-caret": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "alpinejs": "^3.17.4",
    "diff": "^9.0.0",
    "htmx.org": "^2.0.11",
    "lucide": "^1.49.0",
    "pdfjs-dist": "^6.0.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.3",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
