{
  "name": "mandari-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "build:editor": "esbuild frontend/editor/index.ts --bundle --outfile=static/js/editor.bundle.js --format=iife --global-name=MandariEditor --minify --target=es2020",
    "watch:editor": "esbuild frontend/editor/index.ts --bundle --outfile=static/js/editor.bundle.js --format=iife --global-name=MandariEditor --target=es2020 --watch",
    "build": "npm run build:css && npm run build:editor",
    "test:paste": "node frontend/editor/test/paste-cleanup.test.mjs",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:editor\""
  },
  "dependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-character-count": "^2.11.0",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/suggestion": "^2.27.2",
    "@tiptap/y-tiptap": "^2.0.0",
    "diff": "^8.0.3",
    "pdfjs-dist": "^4.9.155",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.0"
  }
}
