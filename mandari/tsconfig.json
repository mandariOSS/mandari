{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./frontend",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["frontend/**/*.ts"],
  "exclude": ["node_modules", "dist", "static"]
}
