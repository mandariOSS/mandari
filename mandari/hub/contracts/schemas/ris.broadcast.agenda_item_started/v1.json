{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandari:event:ris.broadcast.agenda_item_started:v1",
  "title": "Tagesordnungspunkt in der Übertragung begonnen",
  "description": "Laut Einblendung der Kommune (TOP-Nummer mit Titelprüfung, zweimal gleich zugeordnet) bzw. von Hand beginnt in der Übertragung ein Tagesordnungspunkt (hub.live, Issue #915, #47). Aggregat: Broadcast. Fehlt agenda_item, ließ sich die gelesene Angabe keinem Tagesordnungspunkt der Sitzung zuordnen.",
  "x-kind": "event",
  "x-owner": "hub.live",
  "x-visibility": "oeffentlich",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "broadcast",
    "meeting",
    "section",
    "number",
    "origin"
  ],
  "properties": {
    "broadcast": {
      "description": "Kennung der Übertragung.",
      "type": "string",
      "format": "uuid"
    },
    "meeting": {
      "description": "Kanonische Kennung der Sitzung.",
      "type": "string",
      "format": "uuid"
    },
    "section": {
      "description": "Kennung des Abschnitts der Übertragung.",
      "type": "string",
      "format": "uuid"
    },
    "agenda_item": {
      "description": "Kanonische Kennung des zugeordneten Tagesordnungspunkts.",
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "description": "TOP-Nummer in Normalform, z. B. 5 oder 1.1: die des zugeordneten Tagesordnungspunkts, ohne Zuordnung die gelesene.",
      "type": "string",
      "pattern": "^[0-9]{1,3}(?:[.][0-9]{1,3}){0,3}$"
    },
    "origin": {
      "description": "Herkunft: einblendung (Texterkennung) oder hand (Verwaltung).",
      "type": "string",
      "enum": [
        "einblendung",
        "hand"
      ]
    }
  },
  "examples": [
    {
      "broadcast": "0b6f7a2e-3c1d-4e5f-8a9b-1c2d3e4f5a6b",
      "meeting": "7c9e6679-7425-50de-944b-e07fc1f90ae7",
      "section": "1d2e3f4a-5b6c-4d7e-8f9a-0b1c2d3e4f5a",
      "agenda_item": "9a8b7c6d-5e4f-4a3b-2c1d-0e9f8a7b6c5d",
      "number": "5.1",
      "origin": "einblendung"
    },
    {
      "broadcast": "0b6f7a2e-3c1d-4e5f-8a9b-1c2d3e4f5a6b",
      "meeting": "7c9e6679-7425-50de-944b-e07fc1f90ae7",
      "section": "1d2e3f4a-5b6c-4d7e-8f9a-0b1c2d3e4f5a",
      "number": "12",
      "origin": "einblendung"
    }
  ]
}
