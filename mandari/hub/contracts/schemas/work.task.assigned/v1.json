{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandari:event:work.task.assigned:v1",
  "title": "Aufgabe zugewiesen",
  "description": "Eine Aufgabe wurde angelegt oder einer Mitgliedschaft zugewiesen. Aggregat: Task.",
  "x-kind": "event",
  "x-owner": "apps.work",
  "x-visibility": "intern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "organization"
  ],
  "properties": {
    "task": {
      "description": "Kennung der Aufgabe.",
      "type": "string",
      "format": "uuid"
    },
    "organization": {
      "description": "Organisation der Aufgabe.",
      "type": "string",
      "format": "uuid"
    },
    "assignee": {
      "description": "Mitgliedschaft, der die Aufgabe jetzt zugewiesen ist.",
      "type": "string",
      "format": "uuid"
    },
    "created": {
      "description": "Die Aufgabe wurde mit dieser Zuweisung angelegt.",
      "type": "boolean"
    }
  },
  "examples": [
    {
      "task": "fedcba98-7654-4321-8fed-cba987654321",
      "organization": "3c9a1e2b-4d5f-4a6b-8c7d-9e0f1a2b3c4d",
      "assignee": "abcdef01-2345-4678-9abc-def012345678",
      "created": true
    }
  ]
}
