{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandari:event:work.factionmeeting.invited:v1",
  "title": "Einladung zur Fraktionssitzung versendet",
  "description": "Zu einer Fraktionssitzung wurde eingeladen oder die Einladung aktualisiert. Aggregat: FactionMeeting.",
  "x-kind": "event",
  "x-owner": "apps.work",
  "x-visibility": "intern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "faction_meeting",
    "organization"
  ],
  "properties": {
    "faction_meeting": {
      "description": "Kennung der Fraktionssitzung.",
      "type": "string",
      "format": "uuid"
    },
    "organization": {
      "description": "Organisation der Sitzung.",
      "type": "string",
      "format": "uuid"
    },
    "update": {
      "description": "Aktualisierte Einladung zu einer bereits eingeladenen Sitzung.",
      "type": "boolean"
    }
  },
  "examples": [
    {
      "faction_meeting": "12345678-9abc-4def-8123-456789abcdef",
      "organization": "3c9a1e2b-4d5f-4a6b-8c7d-9e0f1a2b3c4d"
    },
    {
      "faction_meeting": "12345678-9abc-4def-8123-456789abcdef",
      "organization": "3c9a1e2b-4d5f-4a6b-8c7d-9e0f1a2b3c4d",
      "update": true
    }
  ]
}
