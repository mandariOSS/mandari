{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandari:event:work.task.commented:v1",
  "title": "Aufgabe kommentiert",
  "description": "Zu einer Aufgabe wurde ein Kommentar geschrieben. Aggregat: Task.",
  "x-kind": "event",
  "x-owner": "apps.work",
  "x-visibility": "intern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "organization",
    "comment"
  ],
  "properties": {
    "task": {
      "description": "Kennung der Aufgabe.",
      "type": "string",
      "format": "uuid"
    },
    "organization": {
      "description": "Organisation der Aufgabe.",
      "type": "string",
      "format": "uuid"
    },
    "comment": {
      "description": "Kennung des Kommentars (Eintrag im Verlauf der Aufgabe).",
      "type": "string",
      "format": "uuid"
    }
  },
  "examples": [
    {
      "task": "fedcba98-7654-4321-8fed-cba987654321",
      "organization": "3c9a1e2b-4d5f-4a6b-8c7d-9e0f1a2b3c4d",
      "comment": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
    }
  ]
}
