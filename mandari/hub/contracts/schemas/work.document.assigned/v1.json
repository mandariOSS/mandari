{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandari:event:work.document.assigned:v1",
  "title": "Federführung eines Dokuments übertragen",
  "description": "Einer Mitgliedschaft wurde die Federführung für ein Dokument in Work übertragen. Aggregat: Document.",
  "x-kind": "event",
  "x-owner": "apps.work",
  "x-visibility": "intern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "organization",
    "responsible"
  ],
  "properties": {
    "document": {
      "description": "Kennung des Dokuments.",
      "type": "string",
      "format": "uuid"
    },
    "organization": {
      "description": "Organisation, der das Dokument gehört.",
      "type": "string",
      "format": "uuid"
    },
    "responsible": {
      "description": "Mitgliedschaft, die jetzt die Federführung hat.",
      "type": "string",
      "format": "uuid"
    }
  },
  "examples": [
    {
      "document": "0f9e8d7c-6b5a-4938-a7b6-c5d4e3f2a1b0",
      "organization": "3c9a1e2b-4d5f-4a6b-8c7d-9e0f1a2b3c4d",
      "responsible": "abcdef01-2345-4678-9abc-def012345678"
    }
  ]
}
