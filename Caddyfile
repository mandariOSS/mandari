# =============================================================================
# Mandari - Community Edition Caddyfile
# =============================================================================
# Automatic HTTPS via Let's Encrypt (HTTP-01 Challenge)
#
# Routing:
#   /insight/*, /work/*, /session/*, /accounts/*, /admin/*, /api/*, /oparl/*, /data/dcat/*, /csp-report/* … → Mandari (Django)
#   /*  (everything else)                                          → Website (Wagtail)
#
# Requirements:
#   - Port 80 and 443 must be open and accessible from the internet
#   - Domain must point to this server's IP
#   - For localhost: uses HTTP only (no TLS)
# =============================================================================

{
	# Disable admin API (security: prevents config changes at runtime)
	admin off

	# Email for Let's Encrypt certificate notifications
	email {$EMAIL:admin@example.com}
}

# =============================================================================
# Main Site
# =============================================================================
# When DOMAIN=localhost, Caddy serves HTTP only (no TLS for localhost).
# When DOMAIN=example.com, Caddy automatically provisions HTTPS via Let's Encrypt.
# =============================================================================
{$DOMAIN:localhost} {
	# Compression
	encode gzip zstd

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# "?" = nur setzen, wenn die Anwendung keine eigene CSP schickt (z. B. die Sandbox-CSP bei Anlagen)
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'self';"
		-Server
		-X-Powered-By
	}
	# Standort nur für die eigene Seite: „In meiner Nähe“ im Kommunenwechsel fragt ihn auf Klick ab
	# (docs/INSIGHT_KOMMUNENWECHSEL.md); Kamera und Mikrofon bleiben gesperrt.
	# "?" = nur als Vorgabe: Die Website (Wagtail) unter derselben Domain schickt eine eigene, strengere Policy, die
	# der Block oben überschriebe (er wirkt wegen "-Server" erst nach dem Proxy). Als eigene Anweisung, weil Caddy
	# alle "?"-Felder eines Blocks zu einer Bedingung zusammenfasst (gesetzt wird nur, wenn alle fehlen): Sonst fiele
	# die Ersatz-CSP weg, sobald die Website ihre Permissions-Policy schickt, und umgekehrt (#914).
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

	# HSTS only for production domains (not localhost)
	@production not host localhost
	header @production Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# Offensichtliche Scanner-Anfragen gar nicht erst weiterreichen (Issue #344). Keiner dieser
	# Pfade gehört zu mandari, aber jeder davon belegt sonst einen Anwendungs-Thread. Eine Welle
	# solcher Anfragen hat am 22.09.2026 den Datenbank-Pool einer Installation leergeräumt.
	@scanner {
		path */.env* */.git/* */.git */.svn/* */.hg/* */.aws/* */.ssh/* */.DS_Store
		path *.php *.asp *.aspx *.jsp *.cgi *.swp *.bak
		path /wp-* */wp-admin* */wp-content/* */wp-includes/* /wordpress* /xmlrpc*
		path /actuator* /cgi-bin/* /phpmyadmin* /vendor/phpunit/* /server-status /boaform/* /HNAP1*
	}
	handle @scanner {
		respond 404
	}

	# Health check endpoint (for Docker/internal monitoring)
	handle /health {
		respond "OK" 200
	}
	handle /health/ {
		respond "OK" 200
	}

	# =========================================================================
	# Mandari Core (Django) - explicit paths
	# =========================================================================
	@mandari {
		path /insight/* /work/* /session/* /accounts/* /admin/* /api/* /public/* /ws/*
		# OParl-Endpunkt, Nachweise, Kalender, Feedback und CSP-Verstoßmeldungen (#172) gehören zur Anwendung
		path /oparl/* /nachweis/* /kalender/* /feedback/* /csp-report/*
		# Katalog der offenen Ratsinformationen nach DCAT-AP.de für Datenportale (#104)
		path /data/dcat/*
		path /static/* /media/*
		path /sitemap-insight-*
		# PWA (mandari work): Manifest, Service Worker (Root-Scope), Offline-Fallback
		path /manifest.webmanifest /sw.js /offline/
	}
	handle @mandari {
		reverse_proxy mandari:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
			header_up Host {host}
			header_up Connection {header.Connection}
			header_up Upgrade {header.Upgrade}

			# Zero-Downtime: Requests puffern während Container-Swap (~3-5s)
			lb_try_duration 15s
			lb_try_interval 250ms
			fail_duration 10s

			# Upstream Health-Check
			health_uri /health/
			health_interval 5s
			health_timeout 3s
			health_headers {
				Host {$DOMAIN:localhost}
			}

			# Dokumente aus der Ablage (docs/FILE_CACHE.md, „Auslieferung über den Webserver“, #785):
			# Django prüft Zugriff und Sperre und antwortet mit X-Accel-Redirect, Caddy liefert die
			# Bytes (Range/206, ETag). Nur Antworten von Django lösen das aus, nie Anfragen von außen.
			# Typ, Anzeigeart, nosniff und Sandbox kommen aus der Antwort von Django; file_server
			# bestimmt den Typ dann nicht nach der Dateiendung (sonst liefen HTML/SVG im Ursprung).
			# Wirkt erst mit FILE_ACCEL_REDIRECT=true und der Ablage unter OPARL_FILES_MOUNT (read-only).
			@dokument header X-Accel-Redirect /_mandari/dateien/*
			handle_response @dokument {
				root * {$OPARL_FILES_MOUNT:/srv/mandari-files}
				copy_response_headers {
					include Content-Type Content-Disposition X-Content-Type-Options Content-Security-Policy Cache-Control X-Mandari-Cache X-Request-ID
				}
				rewrite * {rp.header.X-Accel-Redirect}
				uri strip_prefix /_mandari/dateien
				file_server
			}
		}
	}

	# =========================================================================
	# Marketing Website (Wagtail) - everything else
	# =========================================================================
	handle {
		reverse_proxy website:8001 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
			header_up Host {host}

			# Zero-Downtime: Requests puffern während Container-Swap
			lb_try_duration 15s
			lb_try_interval 250ms
			fail_duration 10s

			# Upstream Health-Check
			health_uri /health/
			health_interval 5s
			health_timeout 3s
			health_headers {
				Host {$DOMAIN:localhost}
			}
		}
	}

	# Access logging
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 336h   # 14 Tage: Zugriffslogs enthalten IP-Adressen (docs/PROTOKOLLE.md, #263)
		}
	}
}
